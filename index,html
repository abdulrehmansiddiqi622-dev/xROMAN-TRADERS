      document.getElementById('speed-label').textContent = `${animSpeed.toFixed(1)}x`;
    });

    document.getElementById('festive-brightness').addEventListener('input', (e) => {
      const val = parseInt(e.target.value, 10);
      ledBrightness = val / 100;
      document.getElementById('brightness-label').textContent = `${val}%`;
    });

    document.getElementById('mode-rabi').addEventListener('click', () => {
      festiveTheme = 'rabi';
      document.getElementById('mode-rabi').className = 'px-4 py-2.5 rounded-xl bg-emerald-600 text-white text-xs sm:text-sm font-bold flex items-center gap-2 shadow-lg shadow-emerald-600/25 transition';
      document.getElementById('mode-wedding').className = 'px-4 py-2.5 rounded-xl bg-transparent text-slate-300 hover:text-white text-xs sm:text-sm font-bold flex items-center gap-2 transition';
      document.getElementById('festive-stage-badge').innerHTML = '<span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span> LIVE FACADE: Rabi-ul-Awal Noor Mode (Emerald &amp; Pure White)';
    });

    document.getElementById('mode-wedding').addEventListener('click', () => {
      festiveTheme = 'wedding';
      document.getElementById('mode-wedding').className = 'px-4 py-2.5 rounded-xl bg-gold-500 text-obsidian-950 text-xs sm:text-sm font-bold flex items-center gap-2 shadow-lg shadow-gold-500/25 transition';
      document.getElementById('mode-rabi').className = 'px-4 py-2.5 rounded-xl bg-transparent text-slate-300 hover:text-white text-xs sm:text-sm font-bold flex items-center gap-2 transition';
      document.getElementById('festive-stage-badge').innerHTML = '<span class="w-2 h-2 rounded-full bg-gold-400 animate-ping"></span> LIVE FACADE: Royal Wedding Shadi Mode (Warm Gold Waterfall)';
    });

    function drawFestiveScene(time) {
      const w = festiveCanvas.width;
      const h = festiveCanvas.height;
      const t = time * animSpeed;
      fCtx.clearRect(0, 0, w, h);

      const grad = fCtx.createLinearGradient(0, 0, 0, h);
      if (festiveTheme === 'rabi') {
        grad.addColorStop(0, '#031913');
        grad.addColorStop(1, '#070B14');
      } else {
        grad.addColorStop(0, '#1B1104');
        grad.addColorStop(1, '#070B14');
      }
      fCtx.fillStyle = grad;
      fCtx.fillRect(0, 0, w, h);

      const cx = w * 0.5;
      const baseY = h * 0.9;

      if (festiveTheme === 'rabi') {
        fCtx.save();
        fCtx.shadowBlur = 22 * ledBrightness;
        fCtx.shadowColor = '#34D399';
        fCtx.fillStyle = '#ECFDF5';
        fCtx.beginPath();
        fCtx.arc(w * 0.82, h * 0.22, 18, 0, Math.PI * 2);
        fCtx.fill();
        fCtx.fillStyle = '#031913';
        fCtx.beginPath();
        fCtx.arc(w * 0.82 + 7, h * 0.22 - 4, 15, 0, Math.PI * 2);
        fCtx.fill();
        fCtx.restore();

        fCtx.fillStyle = '#07261D';
        fCtx.strokeStyle = '#10B981';
        fCtx.lineWidth = 2;
        fCtx.beginPath();
        fCtx.arc(cx, baseY - 105, 62, Math.PI, 0, false);
        fCtx.lineTo(cx + 62, baseY);
        fCtx.lineTo(cx - 62, baseY);
        fCtx.closePath();
        fCtx.fill();
        fCtx.stroke();
      } else {
        fCtx.fillStyle = '#1F1406';
        fCtx.strokeStyle = '#FFB800';
        fCtx.lineWidth = 2;
        fCtx.beginPath();
        fCtx.arc(cx, baseY - 95, 95, Math.PI, 0, false);
        fCtx.lineTo(cx + 95, baseY);
        fCtx.lineTo(cx - 95, baseY);
        fCtx.closePath();
        fCtx.fill();
        fCtx.stroke();
      }

      [26, 54].forEach((yStart, sIdx) => {
        fCtx.beginPath();
        fCtx.strokeStyle = 'rgba(255,255,255,0.2)';
        fCtx.lineWidth = 1.5;
        for (let x = 0; x <= w; x += 10) {
          const sag = Math.sin((x / w) * Math.PI * 3) * 22;
          if (x === 0) fCtx.moveTo(x, yStart + sag);
          else fCtx.lineTo(x, yStart + sag);
        }
        fCtx.stroke();

        for (let x = 16; x < w - 10; x += 24) {
          const sag = Math.sin((x / w) * Math.PI * 3) * 22;
          const by = yStart + sag;
          const pulse = Math.min(1, (0.6 + 0.4 * Math.sin(t * 0.005 + x * 0.05 + sIdx)) * ledBrightness);
          const bulbColor = festiveTheme === 'rabi' ? ((Math.floor(x / 24) % 2 === 0) ? '#10B981' : '#FFFFFF') : ((Math.floor(x / 24) % 2 === 0) ? '#FFB800' : '#FDE68A');

          fCtx.save();
          fCtx.globalAlpha = pulse;
          fCtx.shadowBlur = 16 * ledBrightness;
          fCtx.shadowColor = bulbColor;
          fCtx.fillStyle = bulbColor;
          fCtx.beginPath();
          fCtx.arc(x, by + 5, 4.5, 0, Math.PI * 2);
          fCtx.fill();
          fCtx.restore();
        }
      });
    }

    let breakerState = 'ON';
    function initThreeHero() {
      const container = document.getElementById('hero-3d-container');
      const scene = new THREE.Scene();
      const camera = new THREE.PerspectiveCamera(42, container.clientWidth / container.clientHeight, 0.1, 1000);
      camera.position.set(0, 0.5, 7.2);

      const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
      renderer.setSize(container.clientWidth, container.clientHeight);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      container.appendChild(renderer.domElement);

      const ambientLight = new THREE.AmbientLight(0xffffff, 0.65);
      scene.add(ambientLight);

      const cyanKeyLight = new THREE.DirectionalLight(0x00E5FF, 1.35);
      cyanKeyLight.position.set(5, 6, 7);
      scene.add(cyanKeyLight);

      const showcaseGroup = new THREE.Group();
      scene.add(showcaseGroup);

      const mcbGroup = new THREE.Group();
      mcbGroup.position.set(-1.15, 0, 0);
      showcaseGroup.add(mcbGroup);

      const bodyMesh = new THREE.Mesh(
        new THREE.BoxGeometry(1.75, 2.8, 1.25),
        new THREE.MeshStandardMaterial({ color: 0xE2E8F0, roughness: 0.35, metalness: 0.1 })
      );
      mcbGroup.add(bodyMesh);

      const facePlate = new THREE.Mesh(
        new THREE.BoxGeometry(1.79, 0.58, 1.29),
        new THREE.MeshStandardMaterial({ color: 0x0F172A, roughness: 0.4 })
      );
      facePlate.position.y = 0.72;
      mcbGroup.add(facePlate);

      const cyanStripe = new THREE.Mesh(
        new THREE.BoxGeometry(1.81, 0.12, 1.31),
        new THREE.MeshStandardMaterial({ color: 0x00E5FF, emissive: 0x00E5FF, emissiveIntensity: 0.45 })
      );
      cyanStripe.position.y = 0.42;
      mcbGroup.add(cyanStripe);

      const statusMat = new THREE.MeshStandardMaterial({ color: 0x10B981, emissive: 0x10B981, emissiveIntensity: 0.95 });
      const statusWindow = new THREE.Mesh(new THREE.BoxGeometry(0.68, 0.22, 0.1), statusMat);
      statusWindow.position.set(0, 0.14, 0.64);
      mcbGroup.add(statusWindow);

      const leverPivot = new THREE.Group();
      leverPivot.position.set(0, -0.32, 0.58);
      mcbGroup.add(leverPivot);

      const toggleLever = new THREE.Mesh(
        new THREE.BoxGeometry(0.78, 0.24, 0.58),
        new THREE.MeshStandardMaterial({ color: 0x00B8D4, roughness: 0.3 })
      );
      toggleLever.position.z = 0.24;
      leverPivot.add(toggleLever);
      leverPivot.rotation.x = -0.45;

      const copperMat = new THREE.MeshStandardMaterial({
        color: 0xFFB800,
        metalness: 0.88,
        roughness: 0.18,
        emissive: 0xD97706,
        emissiveIntensity: 0.2
      });

      const topBusbar = new THREE.Mesh(new THREE.CylinderGeometry(0.12, 0.12, 1.35, 18), copperMat);
      topBusbar.position.set(0, 1.95, 0);
      mcbGroup.add(topBusbar);

      const bottomBusbar = new THREE.Mesh(new THREE.CylinderGeometry(0.12, 0.12, 1.35, 18), copperMat);
      bottomBusbar.position.set(0, -1.95, 0);
      mcbGroup.add(bottomBusbar);

      const coilGroup = new THREE.Group();
      coilGroup.position.set(1.55, 0.05, -0.15);
      showcaseGroup.add(coilGroup);

      for (let i = 0; i < 5; i++) {
        const coilRing = new THREE.Mesh(new THREE.TorusGeometry(0.88 - i * 0.055, 0.072, 16, 48), copperMat);
        coilRing.position.z = (i - 2) * 0.12;
        coilGroup.add(coilRing);
      }

      const flowParticles = [];
      const flowGeo = new THREE.SphereGeometry(0.06, 12, 12);
      for (let i = 0; i < 20; i++) {
        const pMat = new THREE.MeshBasicMaterial({ color: i % 2 === 0 ? 0x00E5FF : 0xFFB800 });
        const pMesh = new THREE.Mesh(flowGeo, pMat);
        scene.add(pMesh);
        flowParticles.push({ mesh: pMesh, angle: (i / 20) * Math.PI * 2, radius: 2.55 + (i % 3) * 0.25, yOffset: ((i % 5) - 2) * 0.55 });
      }

      const sparks = [];
      const sparkGeo = new THREE.SphereGeometry(0.055, 8, 8);
      for (let i = 0; i < 28; i++) {
        const sMat = new THREE.MeshBasicMaterial({ color: i % 2 === 0 ? 0xFFB800 : 0xFFFFFF, transparent: true, opacity: 0 });
        const sMesh = new THREE.Mesh(sparkGeo, sMat);
        scene.add(sMesh);
        sparks.push({ mesh: sMesh, vx: 0, vy: 0, vz: 0, life: 0 });
      }

      function triggerSparkBurst() {
        sparks.forEach(s => {
          s.mesh.position.set(-1.15, -0.2, 0.8);
          s.vx = (Math.random() - 0.5) * 0.22;
          s.vy = (Math.random() - 0.3) * 0.22;
          s.vz = (Math.random() * 0.18) + 0.04;
          s.life = 1.0;
          s.mesh.material.opacity = 1;
        });
        const flashEl = document.getElementById('short-circuit-flash');
        flashEl.classList.remove('trip-flash-active');
        void flashEl.offsetWidth;
        flashEl.classList.add('trip-flash-active');
      }

      let isDragging = false;
      let prevX = 0;
      let prevY = 0;
      let targetRotY = 0.16;
      let targetRotX = 0.04;
      let targetZ = 7.2;

      container.addEventListener('mousedown', e => { isDragging = true; prevX = e.clientX; prevY = e.clientY; });
      window.addEventListener('mousemove', e => {
        if (!isDragging) return;
        targetRotY += (e.clientX - prevX) * 0.008;
        targetRotX += (e.clientY - prevY) * 0.006;
        targetRotX = Math.max(-0.55, Math.min(0.55, targetRotX));
        prevX = e.clientX;
        prevY = e.clientY;
      });
      window.addEventListener('mouseup', () => { isDragging = false; });

      container.addEventListener('wheel', e => {
        e.preventDefault();
        targetZ += e.deltaY * 0.004;
        targetZ = Math.max(4.8, Math.min(9.5, targetZ));
      }, { passive: false });

      function setBreakerState(newState) {
        breakerState = newState;
        const dot = document.getElementById('telemetry-dot');
        const text = document.getElementById('telemetry-text');
        const expBar = document.getElementById('breaker-explanation-bar');
        const expText = document.getElementById('breaker-explanation-text');

        if (newState === 'ON') {
          leverPivot.rotation.x = -0.45;
          statusMat.color.setHex(0x10B981);
          statusMat.emissive.setHex(0x10B981);
          copperMat.emissiveIntensity = 0.25;
          dot.className = 'w-2.5 h-2.5 rounded-full bg-emerald-400 shadow-[0_0_12px_#10B981]';
          text.className = 'text-xs font-mono font-bold tracking-wide text-emerald-400 uppercase';
          text.textContent = 'STATUS: CIRCUIT ON • 220V NOMINAL SAFE';
          expBar.className = 'px-5 py-3 bg-emerald-500/10 border-t border-emerald-500/25 flex items-center gap-3 text-xs text-emerald-200';
          expText.innerHTML = '<strong>Active Protection:</strong> Pure copper coils are conducting steady 220V power. Thermal-magnetic trip sensor is armed against overload.';
        } else if (newState === 'OFF') {
          leverPivot.rotation.x = 0.45;
          statusMat.color.setHex(0x64748B);
          statusMat.emissive.setHex(0x1E293B);
          copperMat.emissiveIntensity = 0.02;
          dot.className = 'w-2.5 h-2.5 rounded-full bg-slate-400';
          text.className = 'text-xs font-mono font-bold tracking-wide text-slate-300 uppercase';
          text.textContent = 'STATUS: SWITCHED OFF • CIRCUIT ISOLATED';
          expBar.className = 'px-5 py-3 bg-white/5 border-t border-white/10 flex items-center gap-3 text-xs text-slate-300';
          expText.innerHTML = '<strong>Manual Isolation:</strong> Circuit contacts are physically separated, ensuring zero live voltage downstream.';
        } else if (newState === 'TRIPPED') {
          leverPivot.rotation.x = 0.48;
          statusMat.color.setHex(0xEF4444);
          statusMat.emissive.setHex(0xEF4444);
          copperMat.emissiveIntensity = 0.02;
          triggerSparkBurst();
          dot.className = 'w-2.5 h-2.5 rounded-full bg-red-500 shadow-[0_0_12px_#EF4444] animate-ping';
          text.className = 'text-xs font-mono font-bold tracking-wide text-red-400 uppercase';
          text.textContent = 'ALERT: SHORT-CIRCUIT TRIPPED IN 0.01s!';
          expBar.className = 'px-5 py-3 bg-red-500/15 border-t border-red-500/35 flex items-center gap-3 text-xs text-red-200';
          expText.innerHTML = '<strong>Hazard Neutralized:</strong> Magnetic solenoid detected a sudden short-circuit surge and tripped in 10ms.';
        }
      }

      document.getElementById('btn-switch-on').addEventListener('click', () => {
        setBreakerState('ON');
        showToast('Circuit Breaker ON', '220V nominal supply restored.');
      });
      document.getElementById('btn-switch-off').addEventListener('click', () => {
        setBreakerState('OFF');
        showToast('Circuit Breaker OFF', 'Downstream circuit safely isolated.');
      });
      document.getElementById('btn-short-circuit').addEventListener('click', () => {
        setBreakerState('TRIPPED');
        showToast('Short-Circuit Trip Simulated!', 'MCB disconnected power in 0.01s.', 'warning');
      });

      window.addEventListener('resize', () => {
        if (!container) return;
        camera.aspect = container.clientWidth / container.clientHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(container.clientWidth, container.clientHeight);
        resizeFestiveCanvas();
      });

      function animate(time) {
        requestAnimationFrame(animate);
        if (!isDragging) targetRotY += 0.0035;
        showcaseGroup.rotation.y += (targetRotY - showcaseGroup.rotation.y) * 0.08;
        showcaseGroup.rotation.x += (targetRotX - showcaseGroup.rotation.x) * 0.08;
        camera.position.z += (targetZ - camera.position.z) * 0.08;
        coilGroup.rotation.z += breakerState === 'ON' ? 0.014 : 0.001;

        flowParticles.forEach((p, idx) => {
          const speed = breakerState === 'ON' ? 0.02 : 0.001;
          p.angle += speed;
          p.mesh.position.x = Math.cos(p.angle) * p.radius;
          p.mesh.position.z = Math.sin(p.angle) * p.radius;
          p.mesh.position.y = p.yOffset + Math.sin(time * 0.003 + idx) * 0.14;
          p.mesh.scale.setScalar(breakerState === 'ON' ? 1.0 : 0.35);
        });

        sparks.forEach(s => {
          if (s.life > 0) {
            s.mesh.position.x += s.vx;
            s.mesh.position.y += s.vy;
            s.mesh.position.z += s.vz;
            s.vy -= 0.008;
            s.life -= 0.032;
            s.mesh.material.opacity = Math.max(0, s.life);
          }
        });

        renderer.render(scene, camera);
        drawFestiveScene(time);
      }

      resizeFestiveCanvas();
      animate(0);
    }

    window.onload = function () {
      renderProducts('all');
      updateCalculator();
      initThreeHero();
    };
  </script>
</body>
</html>
